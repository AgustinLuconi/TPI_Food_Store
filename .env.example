# Variables del despliegue con Docker Compose (docker-compose.yml). Copiar a .env y completar:
#   cp .env.example .env
# Nunca subir el .env al repositorio. (El backend, cuando se corre sin Docker, usa su propio backend/.env.)

# --- Base de datos ---
POSTGRES_USER=foodstore
# CAMBIAR en producción.
POSTGRES_PASSWORD=foodstore
POSTGRES_DB=foodstore

# --- Backend ---
# Clave de firma de los JWT. OBLIGATORIA, mínimo 32 caracteres. La de abajo es SOLO para probar en tu máquina
# (es pública, está en el repositorio). En producción generar una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=clave-solo-para-probar-docker-no-usar-en-produccion

# "production" activa COOKIE_SECURE: las cookies de sesión viajan SOLO por HTTPS. Dejar "development" mientras se
# prueba por http://localhost; en un servidor con HTTPS poner "production".
ENVIRONMENT=development

# Orígenes permitidos por CORS (lista JSON). Con Nginx la SPA y la API comparten origen, así que casi no se usa.
CORS_ORIGINS=["http://localhost"]

# --- Nginx ---
# Puerto del host donde se publica la aplicación (Nginx es el único servicio que publica un puerto).
HTTP_PORT=80

# --- MercadoPago (Anexo B, opcional) ---
# Sin MP_ACCESS_TOKEN y MP_PUBLIC_KEY la forma de pago MERCADOPAGO no se ofrece y el resto funciona igual.
# Se obtienen en https://www.mercadopago.com.ar/developers (Tus integraciones → Credenciales de prueba).
# Credencial PRIVADA del backend (nunca al frontend ni al repositorio):
MP_ACCESS_TOKEN=
# Clave PÚBLICA para el SDK del navegador (se expone en GET /pagos/mercadopago/config):
MP_PUBLIC_KEY=
# URL pública del webhook (MercadoPago no puede llamar a localhost: usar el dominio o un túnel):
#   https://<dominio>/api/v1/pagos/webhook
MP_NOTIFICATION_URL=
# Clave para validar la firma de las notificaciones (Tus integraciones → Webhooks → Clave secreta):
MP_WEBHOOK_SECRET=
