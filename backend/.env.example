# Copiar a .env y completar. Nunca subir .env al repositorio.

# Conexión a PostgreSQL. Para la base de docker-compose.dev.yml (puerto 5434 en el host):
DATABASE_URL=postgresql://foodstore:foodstore@localhost:5434/foodstore

# Clave de firma de los JWT. OBLIGATORIA, mínimo 32 caracteres, sin valor por defecto en el código.
# La de abajo es SOLO PARA DESARROLLO LOCAL (es pública, está en el repositorio): sirve para que
# `cp .env.example .env` funcione sin tocar nada. En producción generar una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=clave-solo-para-desarrollo-local-no-usar-en-produccion

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes permitidos por CORS (lista JSON).
CORS_ORIGINS=["http://localhost:5173"]

# Directorio de imágenes de productos.
MEDIA_DIR=./media

# "production" activa COOKIE_SECURE (cookies solo por HTTPS).
ENVIRONMENT=development

# --- Opcionales (si se omiten se usan estos valores) ---
# Coste de bcrypt; la especificación exige 12 o más.
# BCRYPT_ROUNDS=12
# Rate limiting del login (sección 5.4): intentos fallidos permitidos por IP y ventana en minutos.
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15

# --- MercadoPago (Anexo B, opcional) ---
# Sin MP_ACCESS_TOKEN y MP_PUBLIC_KEY la forma de pago MERCADOPAGO no se ofrece y el resto funciona igual.
# Se obtienen en https://www.mercadopago.com.ar/developers (Tus integraciones → Credenciales de prueba).
# Credencial PRIVADA del backend (nunca al frontend ni al repositorio):
MP_ACCESS_TOKEN=
# Clave PÚBLICA para el SDK del navegador (se expone en GET /pagos/mercadopago/config):
MP_PUBLIC_KEY=
# URL pública del webhook (MercadoPago no puede llamar a localhost: usar el dominio o un túnel):
#   https://<dominio>/api/v1/pagos/webhook
MP_NOTIFICATION_URL=
# Clave para validar la firma de las notificaciones (Tus integraciones → Webhooks → Clave secreta):
MP_WEBHOOK_SECRET=
