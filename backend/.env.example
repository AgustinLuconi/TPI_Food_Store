# Copiar a .env y completar. Nunca subir .env al repositorio.

# Conexión a PostgreSQL. Para la base de docker-compose.dev.yml (puerto 5434 en el host):
DATABASE_URL=postgresql://foodstore:foodstore@localhost:5434/foodstore

# Clave de firma de los JWT. OBLIGATORIA, mínimo 32 caracteres, sin valor por defecto.
# Generar una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes permitidos por CORS (lista JSON).
CORS_ORIGINS=["http://localhost:5173"]

# Directorio de imágenes de productos.
MEDIA_DIR=./media

# "production" activa COOKIE_SECURE (cookies solo por HTTPS).
ENVIRONMENT=development
